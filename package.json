{
    "name": "laravel-starter-kit",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "preinstall": "node ensure-node-env.js",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "test:unit": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "cleanup": "npm run format && npm run lint && npm run typecheck"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify/json": "^2.2.504",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@types/node": "^26.1.1",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^10.0.3",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.65.0",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-icons": "^23.0.1",
        "unplugin-vue-components": "^32.1.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.7"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.6.1",
        "@inertiajs/vue3": "^3.6.1",
        "@laravel/echo-vue": "^2.4.0",
        "@lucide/vue": "^1.25.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/vue-table": "^8.21.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.1.3",
        "pinia": "^4.0.2",
        "pusher-js": "^8.5.0",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vue": "^3.5.40"
    },
    "overrides": {
        "glob": "^12.0.0",
        "shell-quote": "^1.10.0"
    },
    "optionalDependencies": {
        "@rolldown/binding-linux-x64-gnu": "1.1.5",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
        "lightningcss-linux-x64-gnu": "1.32.0"
    },
    "engines": {
        "node": ">=24.1.0",
        "npm": ">=11.2.1"
    },
    "engineStrict": true
}
