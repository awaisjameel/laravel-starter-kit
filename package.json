{
    "name": "laravel-starter-kit",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "preinstall": "node ensure-node-env.js",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "test:unit": "vitest run",
        "format": "prettier --write --cache --cache-strategy content .",
        "format:check": "prettier --check --cache --cache-strategy content .",
        "lint": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
        "lint:check": "eslint . --max-warnings=0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
        "cleanup": "npm run format && npm run lint && npm run typecheck"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify/json": "^2.2.526",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@types/node": "^26.5.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
        "typescript-eslint": "^8.70.0",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-icons": "^23.0.1",
        "unplugin-vue-components": "^32.1.0",
        "vitest": "^5.0.0",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.7.0",
        "@inertiajs/vue3": "^3.7.0",
        "@laravel/echo-vue": "^2.5.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.4.0",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.5.0",
        "laravel-vite-plugin": "^3.2.0",
        "pinia": "^4.0.3",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vite": "^8.2.2",
        "vue": "^3.5.42"
    },
    "overrides": {
        "shell-quote": "^1.10.0",
        "typescript": "$typescript"
    },
    "optionalDependencies": {
        "@rolldown/binding-linux-x64-gnu": "1.2.7",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
        "lightningcss-linux-x64-gnu": "1.33.0"
    },
    "engines": {
        "node": ">=24.15.0",
        "npm": ">=11.2.1"
    },
    "allowScripts": {
        "vue-demi@0.14.10": true
    }
}
