{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "awaisjameel/laravel-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework focused on security and type safety.",
    "keywords": [
        "Laravel Starter kit",
        "Security and Type safety"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.1.1",
        "laravel/framework": "^13.21.1",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.20",
        "nunomaduro/essentials": "^1.2.0",
        "spatie/laravel-data": "^4.23.0",
        "spatie/laravel-typescript-transformer": "^3.3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4.13",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.29.3",
        "laravel/sail": "^1.64.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#34d399\" \"php artisan serve\" \"php artisan queue:listen --queue=realtime,high,default --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" \"php artisan reverb:start --host=0.0.0.0 --port=8080 --hostname=127.0.0.1 --no-interaction\" --names=server,queue,logs,vite,reverb --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#34d399\" \"php artisan serve\" \"php artisan queue:listen --queue=realtime,high,default --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" \"php artisan reverb:start --host=0.0.0.0 --port=8080 --hostname=127.0.0.1 --no-interaction\" --names=server,queue,logs,ssr,reverb --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ],
        "test:parallel": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --parallel"
        ],
        "test:fast": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --parallel --tia"
        ],
        "format": [
            "@php vendor/bin/pint --parallel"
        ],
        "format:check": [
            "@php vendor/bin/pint --test"
        ],
        "refactor": [
            "@php vendor/bin/rector process"
        ],
        "refactor:check": [
            "@php vendor/bin/rector process --dry-run"
        ],
        "cleanup": [
            "@refactor",
            "@format",
            "@analyse",
            "npm run cleanup"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --ansi"
        ],
        "qa:check": [
            "@refactor:check",
            "@format:check",
            "@analyse",
            "npm run format:check",
            "npm run lint:check",
            "npm run typecheck"
        ],
        "generate": [
            "@php artisan modules:cache --no-interaction",
            "@php artisan typescript:transform",
            "@php artisan wayfinder:generate"
        ],
        "generate-and-cleanup": [
            "@generate",
            "@refactor",
            "@format",
            "@analyse",
            "npm run cleanup"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
